cmake_minimum_required(VERSION 3.24)

foreach(required SOURCE_DIR DESTINATION_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "SyncAssets: ${required} is not set.")
    endif()
endforeach()

if(NOT IS_DIRECTORY "${SOURCE_DIR}")
    file(MAKE_DIRECTORY "${SOURCE_DIR}")
    message(STATUS "SpinoCore: created the assets folder ${SOURCE_DIR}")
endif()
if(EXISTS "${DESTINATION_DIR}" AND NOT IS_DIRECTORY "${DESTINATION_DIR}")
    file(REMOVE "${DESTINATION_DIR}")
endif()
file(MAKE_DIRECTORY "${DESTINATION_DIR}")

file(GLOB_RECURSE sourceEntries LIST_DIRECTORIES true RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
file(GLOB_RECURSE destinationEntries LIST_DIRECTORIES true RELATIVE "${DESTINATION_DIR}" "${DESTINATION_DIR}/*")
list(SORT sourceEntries)

set(copied 0)
set(removed 0)

foreach(entry IN LISTS sourceEntries)
    set(from "${SOURCE_DIR}/${entry}")
    set(to "${DESTINATION_DIR}/${entry}")

    if(IS_DIRECTORY "${from}")
        if(EXISTS "${to}" AND NOT IS_DIRECTORY "${to}")
            file(REMOVE "${to}")
        endif()
        file(MAKE_DIRECTORY "${to}")
    else()
        if(IS_DIRECTORY "${to}")
            file(REMOVE_RECURSE "${to}")
        endif()
        if(NOT EXISTS "${to}")
            file(COPY_FILE "${from}" "${to}")
            math(EXPR copied "${copied} + 1")
        else()
            file(SHA256 "${from}" fromHash)
            file(SHA256 "${to}" toHash)
            if(NOT fromHash STREQUAL toHash)
                file(COPY_FILE "${from}" "${to}")
                math(EXPR copied "${copied} + 1")
            endif()
        endif()
    endif()
endforeach()

foreach(entry IN LISTS destinationEntries)
    if(NOT EXISTS "${SOURCE_DIR}/${entry}" AND (EXISTS "${DESTINATION_DIR}/${entry}" OR IS_SYMLINK "${DESTINATION_DIR}/${entry}"))
        file(REMOVE_RECURSE "${DESTINATION_DIR}/${entry}")
        math(EXPR removed "${removed} + 1")
    endif()
endforeach()

if(copied GREATER 0 OR removed GREATER 0)
    message(STATUS "SpinoCore assets: ${copied} copied, ${removed} removed")
endif()
